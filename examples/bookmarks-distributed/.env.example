# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.
#
# Generate AUTUMN_SECURITY__SIGNING_SECRET:
#
#   PowerShell:
#     -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#
#   bash / openssl:
#     openssl rand -hex 32
#
# All replicas must share the same value so session cookies and CSRF tokens
# signed by one replica are accepted by the others.

AUTUMN_SECURITY__SIGNING_SECRET=

# Shared HMAC key for the two-node cluster substrate (docs/guide/clustering.md).
# At least 16 bytes, and identical on every node — a frame signed with any
# other key is dropped and counted on
# autumn_cluster_frames_rejected_total{reason="mac"}. Cluster traffic is
# authenticated but NOT encrypted, so deploy it on a trusted network.
#
#   openssl rand -hex 32

AUTUMN_CLUSTER__SECRET=
