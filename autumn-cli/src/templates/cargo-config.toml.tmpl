# Windows PDB files cap public symbols (LNK4318, LNK4319). The linker
# suggests this flag itself. It has no effect on other targets.
# It is a link.exe option, the default MSVC linker. If you use lld-link,
# delete these rustflags: lld-link rejects the flag.
# Cargo applies target rustflags to every profile, so release builds on
# Windows use the flag too. Delete these rustflags if that is a problem.
[target.x86_64-pc-windows-msvc]
rustflags = ["-Clink-arg=/DEBUG:LongSymbolTruncate"]

[target.aarch64-pc-windows-msvc]
rustflags = ["-Clink-arg=/DEBUG:LongSymbolTruncate"]
