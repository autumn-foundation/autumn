use autumn_web::seed::SeedContext;

#[autumn_web::main]
async fn main() {
    let ctx = match SeedContext::build() {
        Ok(ctx) => ctx,
        Err(err) => {
            eprintln!(
                "autumn console: could not resolve configuration or build the database pool: {err}"
            );
            std::process::exit(1);
        }
    };

    eprintln!("autumn console: profile `{}`", ctx.profile());

    let mut db = match ctx.conn().await {
        Ok(db) => db,
        Err(err) => {
            eprintln!("autumn console: could not connect to the database: {err}");
            std::process::exit(1);
        }
    };

    // ── your code here ─────────────────────────────────────────────────────
    //
    // `db` is a live pooled connection: pass `&mut db` (or `&mut *db`) to
    // Diesel and model calls. `ctx.pool()` hands you the pool itself for the
    // APIs that want one — repositories and factories, for example.
