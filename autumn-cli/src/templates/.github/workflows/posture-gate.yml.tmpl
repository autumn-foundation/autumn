# Security posture gate, generated by `autumn new {{project_name}}` (issue #1624).
#
# `autumn routes audit` proves what this app's security surface IS. This
# workflow answers the next question on every pull request: what did the change
# DO to it, and did a human agree?
#
# How it works:
#
#   1. Build this commit's posture manifest (`autumn routes audit --manifest`).
#   2. Check the committed `security-posture.json` matches what was just built —
#      a stale committed manifest would make the diff below lie.
#   3. Read the base branch's committed manifest out of git (no second build).
#   4. Diff the two. Widening changes — a new public route, a gate removed or
#      loosened, a classification downgraded — fail this check. Narrowing and
#      neutral changes annotate and never block. No posture change posts
#      nothing at all.
#   5. Post (or update) one comment carrying the diff.
#
# Unblocking a widening you meant to make — the escape hatch, and the only one:
# comment on the pull request with the line the report prints,
#
#     /ack-posture <digest>  the reason this is intended
#
# from an account with write access (OWNER, MEMBER or COLLABORATOR — the
# harvest step below enforces that). The digest names that exact set of
# widenings: pushing unrelated commits keeps the acknowledgment valid, and a
# NEW widening needs a new one. There is no switch that hides the diff.
#
# Turning it on for the first time: the first run finds no baseline on the base
# branch, blocks nothing, and tells you to commit `security-posture.json`. From
# the next pull request on, the gate bites.
#
# Make it a required check in Settings → Branches once you have a baseline.

name: Security posture

on:
  pull_request:

permissions:
  contents: read
  # To post the posture diff as a comment. Nothing else in this workflow writes.
  pull-requests: write

env:
  CARGO_TERM_COLOR: always
  # Where the app's committed posture baseline lives. Change it here and in the
  # `autumn routes audit --manifest` step together.
  POSTURE_MANIFEST: security-posture.json

jobs:
  posture:
    name: Security posture diff
    runs-on: ubuntu-latest

    steps:
      # The base branch's copy of the manifest is read out of git below, so the
      # base ref has to be in the checkout.
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: dtolnay/rust-toolchain@{{rust_version}}

      - uses: Swatinem/rust-cache@v2

      - name: Install the autumn CLI
        run: |
          curl -fsSL "https://raw.githubusercontent.com/autumn-foundation/autumn/v{{autumn_version}}/scripts/install.sh" \
            | sh -s -- --version "v{{autumn_version}}"
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"

      # Compiles the app and reads back its macro-expanded auth posture. This is
      # the only build this job pays for: the base side is a file read.
      - name: Build this commit's posture manifest
        run: autumn routes audit --manifest "$POSTURE_MANIFEST"

      # A committed manifest that does not match the built one would make the
      # diff describe a posture this commit does not have.
      - name: Check the committed manifest is up to date
        run: |
          set -euo pipefail
          if git ls-files --error-unmatch "$POSTURE_MANIFEST" >/dev/null 2>&1; then
            if ! git diff --quiet -- "$POSTURE_MANIFEST"; then
              git --no-pager diff -- "$POSTURE_MANIFEST" || true
              echo "::error file=$POSTURE_MANIFEST::the committed posture manifest is out of date — run \`autumn routes audit --manifest $POSTURE_MANIFEST\` and commit the result"
              exit 1
            fi
          else
            echo "::notice::no posture baseline is committed yet — commit $POSTURE_MANIFEST so the next pull request can be diffed against it"
          fi

      # The previously accepted posture. Absent on the first run, on a fresh
      # fork, or when the base branch predates the gate: all bootstrap cases,
      # handled by --allow-missing-base below.
      - name: Read the base branch's posture
        run: |
          set -euo pipefail
          if ! git show "origin/${BASE_REF}:${POSTURE_MANIFEST}" > base-posture.json 2>/dev/null; then
            rm -f base-posture.json
            echo "::notice::no posture manifest on origin/${BASE_REF} — nothing to diff against yet"
          fi
        env:
          BASE_REF: ${{ github.event.pull_request.base.ref }}

      # Acknowledgment markers, and who is allowed to write them. `autumn`
      # itself has no GitHub identity and enforces no authorization: this step
      # is where "who may acknowledge" is decided, by keeping only comments and
      # reviews from accounts with write access to the repository.
      - name: Harvest acknowledgments from authorized reviewers
        run: |
          set -euo pipefail
          : > acks.txt
          AUTHORIZED='["OWNER","MEMBER","COLLABORATOR"]'
          gh api --paginate "repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER}/comments" \
            --jq "map(select(.author_association as \$a | ${AUTHORIZED} | index(\$a))) | .[].body" \
            >> acks.txt
          gh api --paginate "repos/${GITHUB_REPOSITORY}/pulls/${PR_NUMBER}/reviews" \
            --jq "map(select(.author_association as \$a | ${AUTHORIZED} | index(\$a))) | .[].body" \
            >> acks.txt
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ github.event.pull_request.number }}

      - name: Diff the security posture
        id: diff
        run: |
          set +e
          autumn routes posture diff \
            --base base-posture.json \
            --head "$POSTURE_MANIFEST" \
            --allow-missing-base \
            --ack-file acks.txt \
            --format markdown \
            --output posture-diff.md
          echo "status=$?" >> "$GITHUB_OUTPUT"
          set -e
          if [ -s posture-diff.md ]; then
            cat posture-diff.md >> "$GITHUB_STEP_SUMMARY"
          fi

      # One comment, updated in place. A pull request whose posture stops
      # changing has its comment replaced with a short "resolved" note rather
      # than leaving a stale block quoted forever.
      - name: Post the posture diff
        if: always() && steps.diff.outcome != 'skipped'
        run: |
          set -euo pipefail
          MARKER='<!-- autumn-posture-gate -->'
          EXISTING=$(gh api --paginate "repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER}/comments" \
            --jq "map(select(.body | contains(\"${MARKER}\"))) | .[0].id // empty")
          if [ -s posture-diff.md ]; then
            BODY_FILE=posture-diff.md
          elif [ -n "$EXISTING" ]; then
            printf 'No security posture change on this pull request.\n\n%s\n' "$MARKER" > resolved.md
            BODY_FILE=resolved.md
          else
            exit 0
          fi
          if [ -n "$EXISTING" ]; then
            gh api --method PATCH "repos/${GITHUB_REPOSITORY}/issues/comments/${EXISTING}" \
              -F body=@"$BODY_FILE" > /dev/null
          else
            gh api --method POST "repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER}/comments" \
              -F body=@"$BODY_FILE" > /dev/null
          fi
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ github.event.pull_request.number }}

      # Exit code 1 = an unacknowledged widening. Exit code 2 = the tool could
      # not run (bad path, unreadable manifest), which is a build failure, not a
      # security finding.
      - name: Enforce the gate
        run: exit ${{ steps.diff.outputs.status }}
