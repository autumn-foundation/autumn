# .github/workflows/azure-deploy.yml — generated by
# `autumn release init --target azure-container-apps`
#
# Opt-in: this workflow only runs when you push a `v*` tag (or trigger it
# manually), and every credential comes from repo/environment secrets that
# don't exist until you add them — it never fires unauthenticated.
#
# Required repository secrets:
#   AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID / AZURE_SUBSCRIPTION_ID
#     — a service principal with AcrPush on the registry and Contributor on
#       the Container App (see `az ad sp create-for-rbac`).
#   ACR_LOGIN_SERVER   — output of `terraform output acr_login_server`.
#   AZURE_RESOURCE_GROUP — output of `terraform output resource_group_name`.

name: azure-deploy

on:
  push:
    tags:
      - "v*"
  workflow_dispatch:

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write

    steps:
      - uses: actions/checkout@v4

      - name: Azure login
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Log in to Azure Container Registry
        run: az acr login --name "${ACR_LOGIN_SERVER%%.azurecr.io}"
        env:
          ACR_LOGIN_SERVER: ${{ secrets.ACR_LOGIN_SERVER }}

      - name: Build release image
        run: |
          docker build -t "$ACR_LOGIN_SERVER/{{project_name}}:${GITHUB_REF_NAME}" .
        env:
          ACR_LOGIN_SERVER: ${{ secrets.ACR_LOGIN_SERVER }}

      - name: Push to Azure Container Registry
        run: docker push "$ACR_LOGIN_SERVER/{{project_name}}:${GITHUB_REF_NAME}"
        env:
          ACR_LOGIN_SERVER: ${{ secrets.ACR_LOGIN_SERVER }}

      - name: Deploy new image to Azure Container Apps
        run: |
          az containerapp update \
            --name {{project_name}} \
            --resource-group "$AZURE_RESOURCE_GROUP" \
            --image "$ACR_LOGIN_SERVER/{{project_name}}:${GITHUB_REF_NAME}"
        env:
          ACR_LOGIN_SERVER: ${{ secrets.ACR_LOGIN_SERVER }}
          AZURE_RESOURCE_GROUP: ${{ secrets.AZURE_RESOURCE_GROUP }}
