# variables.tf — generated by `autumn release init --target azure-container-apps`

variable "app_name" {
  description = "Name used to prefix every provisioned Azure resource."
  type        = string
  default     = "{{project_name}}"
}

variable "location" {
  description = "Azure region for all resources."
  type        = string
  default     = "eastus"
}

variable "image_tag" {
  description = "Tag of the {{project_name}} image in Azure Container Registry to deploy."
  type        = string
  default     = "latest"
}

variable "db_sku" {
  description = "SKU name for the Postgres Flexible Server (e.g. B_Standard_B1ms for dev, GP_Standard_D2s_v3 for production)."
  type        = string
  default     = "B_Standard_B1ms"
}

# ── Scale config defaults ────────────────────────────────────────────────────
# Min replicas: 1, Max: 10. The http_scale_rule in main.tf (concurrent_requests
# = 10) decides when Container Apps scales between these bounds; it will not
# scale to zero while min_replicas > 0. Set min_replicas = 0 for scale-to-zero.

variable "min_replicas" {
  description = "Minimum number of Container App replicas kept running."
  type        = number
  default     = 1
}

variable "max_replicas" {
  description = "Maximum number of Container App replicas under load."
  type        = number
  default     = 10
}

variable "enable_redis_cache" {
  description = "Provision an optional Azure Redis Cache (mirrors the app's autumn-cache-redis feature flag). Off by default to avoid the extra cost."
  type        = bool
  default     = false
}

# ── Secrets — no default. Supply via TF_VAR_* env vars or your CI's secret
# store. Never commit real values in terraform.tfvars. ──────────────────────

variable "database_admin_password" {
  description = "Administrator password for the Postgres Flexible Server."
  type        = string
  sensitive   = true
}

variable "database_url" {
  description = "Full connection string stored in Key Vault as AUTUMN_DATABASE__PRIMARY_URL; bound into the Container App as a secret ref."
  type        = string
  sensitive   = true
}

variable "signing_secret" {
  description = "Signing secret stored in Key Vault as AUTUMN_SECURITY__SIGNING_SECRET; generate with `openssl rand -hex 32`."
  type        = string
  sensitive   = true
}
