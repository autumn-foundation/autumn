# outputs.tf — generated by `autumn release init --target azure-container-apps`

# local.app_fqdn (also used for AUTUMN_SECURITY__TRUSTED_HOSTS__HOSTS in
# main.tf) — not azurerm_container_app.this.latest_revision_fqdn, which
# names a specific *revision* rather than the stable app-level ingress
# hostname. Visiting the revision-specific hostname sends a different Host
# header than the one trusted_hosts allows and gets a 400; it would also go
# stale as soon as CI creates a new revision outside Terraform (via
# `az containerapp update`), since Terraform's own state isn't refreshed by
# that. local.app_fqdn is plan-time-derivable and never depends on which
# revision currently happens to be active.
output "app_fqdn" {
  description = "Stable public FQDN of the deployed {{project_name}} Container App (its default ingress hostname, not a revision-specific one)."
  value       = local.app_fqdn
}

# The sanitized name Terraform actually gave the Container App
# (local.app_name_safe) — never the raw project name baked in at scaffold
# time. If `app_name` is later edited in terraform.tfvars, this output (and
# therefore azure-deploy.yml, which reads it as a workflow variable rather
# than hardcoding a name) tracks the change automatically.
output "app_name" {
  description = "Sanitized Azure name of the Container App (see local.app_name_safe)."
  value       = azurerm_container_app.this.name
}

output "acr_login_server" {
  description = "Login server for the Azure Container Registry (used by `docker push`/`docker login` and the azure-deploy.yml workflow)."
  value       = azurerm_container_registry.this.login_server
}

output "resource_group_name" {
  description = "Resource group containing every resource provisioned for {{project_name}}."
  value       = azurerm_resource_group.this.name
}

output "migrate_job_name" {
  description = "Name of the one-shot Container Apps Job that runs `autumn migrate`; azure-deploy.yml starts it before deploying a new image."
  value       = azurerm_container_app_job.migrate.name
}
