# outputs.tf — generated by `autumn release init --target azure-container-apps`

output "app_fqdn" {
  description = "Public FQDN of the deployed {{project_name}} Container App."
  value       = azurerm_container_app.this.latest_revision_fqdn
}

output "acr_login_server" {
  description = "Login server for the Azure Container Registry (used by `docker push`/`docker login` and the azure-deploy.yml workflow)."
  value       = azurerm_container_registry.this.login_server
}

output "resource_group_name" {
  description = "Resource group containing every resource provisioned for {{project_name}}."
  value       = azurerm_resource_group.this.name
}

output "migrate_job_name" {
  description = "Name of the one-shot Container Apps Job that runs `autumn migrate`; azure-deploy.yml starts it before deploying a new image."
  value       = azurerm_container_app_job.migrate.name
}
