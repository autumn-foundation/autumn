#!/usr/bin/env bash
# azure-cutover.sh — generated by `autumn release init --target azure-container-apps`
#
# Sets the real image on the {{project_name}} Container App (#2314).
#
# Terraform creates the app with no managed identity, registry or secret refs,
# so the public placeholder image never gets production credentials. This
# script copies them from the migration job. It sends them and the real image
# in ONE write (an ARM merge-PATCH). Separate `az containerapp identity
# assign` / `secret set` calls apply to all revisions, so the placeholder
# would hold the identity until the image update completes.
#
# The identity applies to all revisions, and Azure keeps the old revision
# active until the new one is ready. So the first cutover disables ingress
# (also the internal route), and starts only when the placeholder revision
# has no running replica. Without ingress, with min_replicas = 0 and only
# the HTTP scale rule, nothing can start it again.
#
# Then the script waits for the new revision. It opens external ingress
# (#2312) only when that revision runs the real image. If the FIRST cutover
# fails, the script removes the credentials from the app again. If the
# current revision stays (the same image and env), the script restarts it,
# because a revision reads changed secrets only when it starts.
#
# An app made by an older template has the credentials while it runs the
# placeholder, and terraform apply does not remove them. To remove them, run
# `bash azure-cutover.sh --remove-credentials`. It does nothing to an app that
# runs a real release.
#
# To turn Redis off, run `bash azure-cutover.sh --without-redis` with the
# tag that runs now, then set enable_redis_cache = false and run terraform
# apply. The app stops using Redis before Terraform deletes the cache.
#
# azure-deploy.yml runs this script after migrations. To run it manually, set
# these variables. All except IMAGE_TAG come from `terraform output`. Then run
# `bash azure-cutover.sh`.
#
#   AZURE_APP_NAME, AZURE_RESOURCE_GROUP, AZURE_MIGRATE_JOB_NAME,
#   ACR_LOGIN_SERVER, IMAGE_TAG (the tag you pushed to ACR; not used by
#   --remove-credentials)
#
# Needs: az (logged in) and jq.

set -euo pipefail

MODE=cutover
WITHOUT_REDIS=""
case "${1:-}" in
  "") ;;
  --remove-credentials) MODE=remove ;;
  --without-redis) WITHOUT_REDIS=1 ;;
  *) echo "usage: azure-cutover.sh [--remove-credentials | --without-redis]" >&2; exit 2 ;;
esac

: "${AZURE_APP_NAME:?set AZURE_APP_NAME (terraform output app_name)}"
: "${AZURE_RESOURCE_GROUP:?set AZURE_RESOURCE_GROUP (terraform output resource_group_name)}"
: "${AZURE_MIGRATE_JOB_NAME:?set AZURE_MIGRATE_JOB_NAME (terraform output migrate_job_name)}"
: "${ACR_LOGIN_SERVER:?set ACR_LOGIN_SERVER (terraform output acr_login_server)}"
if [ "$MODE" = cutover ]; then
  : "${IMAGE_TAG:?set IMAGE_TAG (the tag you pushed to ACR)}"
  IMAGE="$ACR_LOGIN_SERVER/$AZURE_APP_NAME:$IMAGE_TAG"
fi
API="api-version=2024-03-01"
# Secret values go through these private files, never through a process
# argument (visible in /proc/*/cmdline).
BODY=$(mktemp)
APP_SECRETS=$(mktemp)
trap 'rm -f "$BODY" "$APP_SECRETS"' EXIT

JOB=$(az containerapp job show \
  --name "$AZURE_MIGRATE_JOB_NAME" \
  --resource-group "$AZURE_RESOURCE_GROUP" \
  --output json)
# To turn Redis off, the app stops using it first, while the cache still
# exists. Then terraform apply deletes the cache and the job's redis-url.
if [ -n "$WITHOUT_REDIS" ]; then
  JOB=$(jq -c '.properties.configuration.secrets |= map(select(.name != "redis-url"))' <<< "$JOB")
fi
APP=$(az containerapp show \
  --name "$AZURE_APP_NAME" \
  --resource-group "$AZURE_RESOURCE_GROUP" \
  --output json)
# GET omits secret values. Send the app's own secrets back with their values,
# because the PATCH replaces the whole secrets array.
az containerapp secret list \
  --name "$AZURE_APP_NAME" \
  --resource-group "$AZURE_RESOURCE_GROUP" \
  --show-values \
  --output json > "$APP_SECRETS"
APP_ID=$(jq -r '.id' <<< "$APP")
OLD_REVISION=$(jq -r '.properties.latestRevisionName // ""' <<< "$APP")
# The active revisions decide if a real release runs. The template image is
# not enough: after a canceled first cutover, the template has the real
# image while the placeholder revision stays active.
ACTIVE=$(az containerapp revision list \
  --name "$AZURE_APP_NAME" \
  --resource-group "$AZURE_RESOURCE_GROUP" \
  --query "[?properties.active].[name, properties.template.containers[0].image]" \
  --output tsv)
RELEASED=""
ACTIVE_REVISIONS=""
while IFS=$'\t' read -r name image; do
  [ -n "$name" ] || continue
  ACTIVE_REVISIONS="$ACTIVE_REVISIONS $name"
  case "$image" in "$ACR_LOGIN_SERVER"/*) RELEASED=1 ;; esac
done <<< "$ACTIVE"
JOB_IDENTITY=$(jq -r '.properties.configuration.registries[0].identity // ""' <<< "$JOB")
# A secret in PATCH form: a Key Vault ref, or a name and value.
SECRET_REF='def secret_ref: if .keyVaultUrl then {name, keyVaultUrl, identity} else {name, value} end;'
JOB_SECRET_NAMES=$(jq -c '[.properties.configuration.secrets // [] | .[].name]' <<< "$JOB")
JOB_SECRET_REFS=$(jq -c '[.properties.configuration.secrets // [] | .[]
  | {name, keyVaultUrl, identity: (.identity // "" | ascii_downcase)}]' <<< "$JOB")
# Redis is off now, but the app still has the redis-url secret. The old
# revision refers to it, so the script removes it only after that revision
# stops.
STALE_REDIS=""
if jq -e 'any(.[]; .name == "redis-url")' "$APP_SECRETS" > /dev/null \
  && ! jq -e 'index("redis-url")' <<< "$JOB_SECRET_NAMES" > /dev/null; then
  STALE_REDIS=1
fi
# The cutover removes redis-url from every env var. A scale rule or a volume
# can also refer to it, and the script cannot remove that ref without
# changing what the app does, so it stops before any write.
if [ "$MODE" = cutover ] && [ -n "$STALE_REDIS" ] \
  && jq -e '.properties.template | (.containers |= map(del(.env)))
            | [.. | objects | .secretRef? // empty] | index("redis-url")' <<< "$APP" > /dev/null; then
  echo "::error::a scale rule or volume of $AZURE_APP_NAME uses redis-url. Remove that reference, then run the script again." >&2
  exit 1
fi

# A PATCH can return 202 Accepted, and a GET can still show the old state.
# So the script reads the app until it shows the change. These checks use
# the app GET, which has no secret values.
# shellcheck disable=SC2016 # a jq program, not a shell expression
APPLIED='
  ($id | ascii_downcase) as $lid
  | [.identity.userAssignedIdentities // {} | to_entries[]
     | select(.value != null) | .key | ascii_downcase] as $ids
  | [.properties.configuration.secrets // [] | .[]
     | {name, keyVaultUrl, identity: (.identity // "" | ascii_downcase)}] as $have
  | .properties.provisioningState == "Succeeded"
    and ($ids | index($lid)) != null
    and any(.properties.configuration.registries // [] | .[];
            .server == $acr and (.identity // "" | ascii_downcase) == $lid)
    and ($want | all(. as $s | $have | index([$s]) != null))'
# shellcheck disable=SC2016 # a jq program, not a shell expression
REMOVED='
  ($id | ascii_downcase) as $lid
  | [.identity.userAssignedIdentities // {} | to_entries[]
     | select(.value != null) | .key | ascii_downcase] as $ids
  | .properties.provisioningState == "Succeeded"
    and ($ids | index($lid)) == null
    and all(.properties.configuration.registries // [] | .[];
            (.identity // "" | ascii_downcase) != $lid)
    and all(.properties.configuration.secrets // [] | .[];
            .name | IN("database-url", "signing-secret", "redis-url") | not)'
# shellcheck disable=SC2016 # a jq program, not a shell expression
REDIS_GONE='
  .properties.provisioningState == "Succeeded"
  and all(.properties.configuration.secrets // [] | .[]; .name != "redis-url")'
# True when the template (any container, scale rule or volume) refers to a
# managed secret.
# shellcheck disable=SC2016 # a jq program, not a shell expression
REFS_MANAGED='[.properties.template | .. | objects | .secretRef? // empty]
  | any(IN("database-url", "signing-secret", "redis-url"))'
app_shows() {
  local now
  now=$(az containerapp show \
    --name "$AZURE_APP_NAME" \
    --resource-group "$AZURE_RESOURCE_GROUP" \
    --output json) || return 1
  jq -e --arg id "$JOB_IDENTITY" --arg acr "$ACR_LOGIN_SERVER" \
    --argjson want "$JOB_SECRET_REFS" "$1" <<< "$now" > /dev/null
}

# A PATCH body goes in a file, not on the command line: it can hold secret
# values. `--body @file` reads it.
patch_app() {
  printf '%s' "$1" > "$BODY"
  az rest --method patch --url "$APP_ID?$API" --body "@$BODY" --output none
}

# Waits until the given revision is the only active one. Provisioned is not
# ready: Azure keeps the old revision active until the new one scales and
# passes its probes. The script checks 30 times, 10 seconds apart.
sole_active() {
  local list others=unknown
  for _ in $(seq 1 30); do
    list=$(az containerapp revision list \
      --name "$AZURE_APP_NAME" \
      --resource-group "$AZURE_RESOURCE_GROUP" \
      --query "[?properties.active].[name, properties.template.containers[0].image]" \
      --output tsv) || return 1
    others=$(cut -f1 <<< "$list" | grep -vxF -- "$1" || true)
    [ -z "$others" ] && return 0
    sleep 10
  done
  return 1
}

# Removes the job's credentials from the app: its identity, the registry
# entry that uses that identity, the three secrets and the four env vars
# that this script sets. Other identities, registries, secrets, env vars and
# containers stay.
#
# Azure deletes a secret only when no active revision refers to it. So if
# the current template refers to one, stage 1 deploys the snapshot
# containers without the four env vars, and waits until that revision is
# provisioned and no other revision is active. Stage 2 then removes the
# identity, registry and secrets, and waits until the app shows it.
remove_credentials() {
  local live status state latest revision body containers source first patch
  live=$(az containerapp show \
    --name "$AZURE_APP_NAME" \
    --resource-group "$AZURE_RESOURCE_GROUP" \
    --output json) || return 1
  # Stage 1 starts from the active revision's containers. After a canceled
  # first cutover, the app template has the real image, which cannot start
  # without its secrets; the active revision still runs the placeholder.
  source=$(jq -c '.properties.template.containers' <<< "$APP")
  read -r first _ <<< "$ACTIVE_REVISIONS"
  if [ -n "${first:-}" ]; then
    source=$(az containerapp revision show \
      --name "$AZURE_APP_NAME" \
      --resource-group "$AZURE_RESOURCE_GROUP" \
      --revision "$first" \
      --query properties.template.containers \
      --output json) || return 1
  fi
  # The stage 1 containers: no env var that refers to a managed secret (in
  # any container), and not the four env vars that this script sets.
  containers=$(jq -c '
    map(if .env then .env = [.env[] | select((.secretRef // "")
            | IN("database-url", "signing-secret", "redis-url") | not)] else . end)
    | .[0].env = [(.[0].env // [])[] | select(.name | IN(
        "AUTUMN_DATABASE__PRIMARY_URL", "AUTUMN_SECURITY__SIGNING_SECRET",
        "AUTUMN_CACHE__BACKEND", "AUTUMN_CACHE__REDIS__URL") | not)]' <<< "$source")
  # A scale rule or a volume can also refer to a secret. The script cannot
  # remove that ref without changing what the app does, so it stops.
  if jq -c --argjson c "$containers" '.properties.template.containers = $c' <<< "$APP" \
    | jq -e "$REFS_MANAGED" > /dev/null; then
    echo "::error::a scale rule or volume of $AZURE_APP_NAME uses a managed secret. Remove that reference, then run the script again." >&2
    return 1
  fi
  # Stage 1 runs when the desired template or the active revision refers to
  # a managed secret. If only the active revision does, an earlier run sent
  # the stage 1 PATCH already: the script waits for that revision instead.
  if jq -e "$REFS_MANAGED" <<< "$live" > /dev/null \
    || jq -e '[.. | objects | .secretRef? // empty]
              | any(IN("database-url", "signing-secret", "redis-url"))' <<< "$source" > /dev/null; then
    status=$(az containerapp show \
      --name "$AZURE_APP_NAME" \
      --resource-group "$AZURE_RESOURCE_GROUP" \
      --query "[[properties.provisioningState, properties.latestRevisionName]]" \
      --output tsv) || return 1
    read -r _ latest <<< "$status"
    revision="$latest"
    # A PATCH is needed when the template still refers to a secret, or when
    # the clean revision of an earlier run failed. The marker env var makes
    # the template differ, so Azure makes a fresh revision.
    patch=""
    if jq -e "$REFS_MANAGED" <<< "$live" > /dev/null; then
      patch=1
    else
      state=$(az containerapp revision show \
        --name "$AZURE_APP_NAME" \
        --resource-group "$AZURE_RESOURCE_GROUP" \
        --revision "$latest" \
        --query properties.provisioningState \
        --output tsv) || return 1
      [ "$state" = Failed ] && patch=1
    fi
    if [ -n "$patch" ]; then
      body=$(jq -cn --argjson app "$APP" --argjson containers "$containers" --arg now "$(date +%s)" '
        {location: $app.location, properties: {template: {containers: ($containers
          | .[0].env = [(.[0].env // [])[] | select(.name != "AUTUMN_CREDENTIAL_CLEANUP")]
                       + [{name: "AUTUMN_CREDENTIAL_CLEANUP", value: $now}])}}}')
      patch_app "$body" || return 1
      revision=""
    fi
    state=""
    for _ in $(seq 1 30); do
      if [ -z "$revision" ]; then
        sleep 10
        status=$(az containerapp show \
          --name "$AZURE_APP_NAME" \
          --resource-group "$AZURE_RESOURCE_GROUP" \
          --query "[[properties.provisioningState, properties.latestRevisionName]]" \
          --output tsv) || return 1
        read -r state revision <<< "$status"
        if [ "$state" != Succeeded ] || [ -z "$revision" ] || [ "$revision" = "$latest" ]; then
          revision=""
          continue
        fi
      fi
      state=$(az containerapp revision show \
        --name "$AZURE_APP_NAME" \
        --resource-group "$AZURE_RESOURCE_GROUP" \
        --revision "$revision" \
        --query properties.provisioningState \
        --output tsv) || return 1
      case "$state" in
        Provisioned) break ;;
        Failed) return 1 ;;
      esac
      sleep 10
    done
    [ "$state" = Provisioned ] || return 1
    # Wait until no other revision is active. The latest revision before
    # stage 1 can be a failed one while an older placeholder is the active
    # one, so the script checks every active revision.
    sole_active "$revision" || return 1
  fi
  body=$(jq -cn --argjson app "$APP" --slurpfile app_secrets "$APP_SECRETS" \
    --arg id "$JOB_IDENTITY" "$SECRET_REF"'
    ($id | ascii_downcase) as $lid
    | ($app.identity.type // "None") as $type
    | ($app.identity.userAssignedIdentities // {}) as $ids
    | ($ids | with_entries(select(.key | ascii_downcase != $lid)) | map_values({})) as $own
    # The snapshot can predate the cutover, so it can lack the job identity.
    # Merge-patch keeps an omitted key, so the body always names it: with
    # the app spelling if the snapshot has one, else as the job spells it.
    | ($ids | with_entries(select(.key | ascii_downcase == $lid)) | map_values(null)
       | if . == {} then {($id): null} else . end) as $drop
    | {location: $app.location,
       identity: (if $own != {} then {type: $type, userAssignedIdentities: ($drop + $own)}
                  elif ($type | test("SystemAssigned")) then {type: "SystemAssigned", userAssignedIdentities: null}
                  else {type: "None", userAssignedIdentities: null} end),
       properties: {
         configuration: {
           registries: [($app.properties.configuration.registries // [])[]
                        | select((.identity // "" | ascii_downcase) != $lid)],
           secrets: ($app_secrets[0]
                     | map(select(.name | IN("database-url", "signing-secret", "redis-url") | not)
                           | secret_ref))}}}')
  patch_app "$body" || return 1
  for _ in $(seq 1 30); do
    sleep 10
    app_shows "$REMOVED" && return 0
  done
  return 1
}

# Only the first cutover rolls back. On a later deploy, the active revision
# is a real release, so the script keeps the credentials.
rollback() {
  [ -n "$RELEASED" ] && return
  echo "::warning::removing the credentials from the placeholder app" >&2
  remove_credentials && return
  echo "::error::rollback failed: remove the identity and secrets from $AZURE_APP_NAME manually" >&2
}

if [ "$MODE" = remove ]; then
  if [ -n "$RELEASED" ]; then
    echo "::error::$AZURE_APP_NAME runs a real release. It needs its credentials." >&2
    exit 1
  fi
  if [ -z "$JOB_IDENTITY" ]; then
    echo "::error::the migration job has no identity. Run terraform apply first." >&2
    exit 1
  fi
  remove_credentials || { echo "::error::cannot remove the credentials from $AZURE_APP_NAME" >&2; exit 1; }
  echo "removed the credentials from the placeholder app $AZURE_APP_NAME"
  exit 0
fi

fail() {
  echo "::error::$1" >&2
  rollback
  exit 1
}

if [ -z "$RELEASED" ]; then
    # The first cutover. Disable ingress, so no request (internal or
    # external) can start the placeholder. Then wait until no placeholder
    # replica runs. The HTTP scaler stops a replica after a 300-second cool
    # down, so the script checks 60 times, 10 seconds apart.
    az containerapp ingress disable \
      --name "$AZURE_APP_NAME" \
      --resource-group "$AZURE_RESOURCE_GROUP" \
      --output none
    for _ in $(seq 1 60); do
      REPLICAS=0
      for revision in $ACTIVE_REVISIONS; do
        COUNT=$(az containerapp replica list \
          --name "$AZURE_APP_NAME" \
          --resource-group "$AZURE_RESOURCE_GROUP" \
          --revision "$revision" \
          --query "length(@)" \
          --output tsv)
        REPLICAS=$((REPLICAS + COUNT))
      done
      [ "$REPLICAS" = "0" ] && break
      sleep 10
    done
    if [ "$REPLICAS" != "0" ]; then
      echo "::error::the placeholder runs $REPLICAS replica(s). Set min_replicas = 0, run terraform apply, and try again." >&2
      exit 1
    fi
fi

# The new containers. The script changes only the app container (the first
# one): it sets the image and the env. Other containers (sidecars) stay. The
# env keeps the variables that this script does not set, and replaces the
# four that it sets. This JSON has no secret values.
CONTAINERS=$(jq -cn --argjson job "$JOB" --argjson app "$APP" --arg image "$IMAGE" '
  any(($job.properties.configuration.secrets // [])[]; .name == "redis-url") as $redis
  | ([{name: "AUTUMN_DATABASE__PRIMARY_URL", secretRef: "database-url"},
      {name: "AUTUMN_SECURITY__SIGNING_SECRET", secretRef: "signing-secret"}]
     + if $redis
       then [{name: "AUTUMN_CACHE__BACKEND", value: "redis"},
             {name: "AUTUMN_CACHE__REDIS__URL", secretRef: "redis-url"}]
       else [] end) as $env
  | $app.properties.template.containers
  # Without Redis, no env var in any container may refer to redis-url.
  | (if $redis then . else
       map(if .env then .env = [.env[] | select(.secretRef != "redis-url")] else . end)
     end)
  | [(.[0]
      | .image = $image
      | .env = ([(.env // [])[] | select(.name | IN(
          "AUTUMN_DATABASE__PRIMARY_URL", "AUTUMN_SECURITY__SIGNING_SECRET",
          "AUTUMN_CACHE__BACKEND", "AUTUMN_CACHE__REDIS__URL",
          "AUTUMN_CREDENTIAL_CLEANUP") | not)] + $env))]
    + .[1:]
')

# A changed template makes a new revision, so the script waits for it. If
# nothing changes (a re-run with the same tag and config), Azure makes no
# new revision. Then the script checks the current revision.
if jq -en --argjson app "$APP" --argjson containers "$CONTAINERS" \
  '$app.properties.template.containers == $containers' > /dev/null; then
  OLD_REVISION=""
  RESTART=1
else
  RESTART=""
fi

# The secrets, registries and identities that you add to the app stay.
PATCH=$(jq -cn --argjson job "$JOB" --argjson app "$APP" --slurpfile app_secrets "$APP_SECRETS" \
  --arg id "$JOB_IDENTITY" --arg acr "$ACR_LOGIN_SERVER" --argjson containers "$CONTAINERS" \
  "$SECRET_REF"'
  ($job.properties.configuration.secrets // [] | map({name, keyVaultUrl, identity})) as $job_secrets
  | if $id == "" or ($job_secrets | length) == 0
    then error("the migration job has no identity or secrets to copy")
    else . end
  | ($job_secrets | map(.name)) as $job_names
  | ($app_secrets[0]
     | map(select(.name as $n | $job_names | index($n) | not) | secret_ref)
     + $job_secrets) as $secrets
  | {location: $app.location,
     identity: {
       type: (if ($app.identity.type // "None" | test("SystemAssigned"))
              then "SystemAssigned,UserAssigned" else "UserAssigned" end),
       userAssignedIdentities: {($id): {}}},
     properties: {
       configuration: {
         registries: ([($app.properties.configuration.registries // [])[]
                       | select(.server != $acr)] + [{server: $acr, identity: $id}]),
         secrets: $secrets},
       template: {containers: $containers}}}
')
patch_app "$PATCH" || fail "the cutover PATCH failed"

# Wait for the new revision. The script checks 60 times, 10 seconds apart.
READY=""
for _ in $(seq 1 60); do
  sleep 10
  # The nested list makes `--output tsv` print one tab-separated row.
  STATUS=$(az containerapp show \
    --name "$AZURE_APP_NAME" \
    --resource-group "$AZURE_RESOURCE_GROUP" \
    --query "[[properties.provisioningState, properties.latestRevisionName]]" \
    --output tsv) || fail "cannot read the app state"
  read -r STATE REVISION <<< "$STATUS"
  case "$STATE" in
    Failed|Canceled) fail "the app update ended as $STATE" ;;
  esac
  if [ "$STATE" != "Succeeded" ] || [ -z "$REVISION" ] || [ "$REVISION" = "$OLD_REVISION" ]; then
    continue
  fi
  app_shows "$APPLIED" || continue
  REVISION_STATUS=$(az containerapp revision show \
    --name "$AZURE_APP_NAME" \
    --resource-group "$AZURE_RESOURCE_GROUP" \
    --revision "$REVISION" \
    --query "[[properties.provisioningState, properties.template.containers[0].image]]" \
    --output tsv) || fail "cannot read revision $REVISION"
  read -r REVISION_STATE REVISION_IMAGE <<< "$REVISION_STATUS"
  case "$REVISION_STATE" in
    Provisioned)
      [ "$REVISION_IMAGE" = "$IMAGE" ] || fail "revision $REVISION runs $REVISION_IMAGE, not $IMAGE"
      READY=1
      break
      ;;
    Failed) fail "revision $REVISION failed to provision" ;;
  esac
done
[ -n "$READY" ] || fail "the new revision was not provisioned in time"

# No new revision: secrets are application-scope, and the running revision
# reads them only when it starts.
if [ -n "$RESTART" ]; then
  az containerapp revision restart \
    --name "$AZURE_APP_NAME" \
    --resource-group "$AZURE_RESOURCE_GROUP" \
    --revision "$REVISION" \
    --output none || fail "cannot restart revision $REVISION"
fi

# On the first cutover, the placeholder now has the identity and secrets.
# Ingress must not wake it, so the script waits until the new revision is
# the only active one.
if [ -z "$RELEASED" ]; then
  sole_active "$REVISION" || fail "the placeholder revision is still active"
fi

# The new revision runs the real image. Open external ingress now. On a
# later run, this command changes nothing.
az containerapp ingress enable \
  --name "$AZURE_APP_NAME" \
  --resource-group "$AZURE_RESOURCE_GROUP" \
  --type external \
  --target-port 3000 \
  --transport http \
  --output none

# Remove the unused redis-url secret when no other revision is active. The
# release runs already, so a failure here is only a warning.
if [ -n "$STALE_REDIS" ]; then
  ACTIVE=true
  if [ -n "$OLD_REVISION" ]; then
    sole_active "$REVISION" && ACTIVE=false
  else
    # No new revision: the current env has no Redis reference.
    ACTIVE=false
  fi
  CLEANUP=$(jq -cn --argjson job "$JOB" --argjson app "$APP" --slurpfile app_secrets "$APP_SECRETS" \
    "$SECRET_REF"'
    ($job.properties.configuration.secrets // [] | map({name, keyVaultUrl, identity})) as $job_secrets
    | ($job_secrets | map(.name) + ["redis-url"]) as $drop
    | {location: $app.location,
       properties: {configuration: {secrets: (($app_secrets[0]
         | map(select(.name as $n | $drop | index($n) | not) | secret_ref)) + $job_secrets)}}}')
  REMOVED_REDIS=""
  if [ "$ACTIVE" = false ] && patch_app "$CLEANUP"; then
    for _ in $(seq 1 30); do
      sleep 10
      if app_shows "$REDIS_GONE"; then REMOVED_REDIS=1; break; fi
    done
  fi
  if [ -n "$REMOVED_REDIS" ]; then
    echo "removed the unused redis-url secret"
  else
    echo "::warning::remove the unused redis-url secret from $AZURE_APP_NAME when no revision uses it" >&2
  fi
fi
echo "cutover complete: $AZURE_APP_NAME runs $IMAGE"
