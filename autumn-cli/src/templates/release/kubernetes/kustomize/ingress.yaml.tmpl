# Set the host and the ingress class in your overlay. The host is also in
# AUTUMN_SECURITY__TRUSTED_HOSTS__HOSTS in deployment.yaml.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{role_object}}
  labels:
    app.kubernetes.io/component: {{role}}
spec:
  rules:
    - host: {{role_host}}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{role_object}}
                port:
                  name: http
