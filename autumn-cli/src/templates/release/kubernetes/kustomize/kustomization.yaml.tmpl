# Kustomize base for {{project_name}}.
# Generated by `autumn release init --target kubernetes`.
# One component per role, in ../components/. Remove a line to leave out a
# role. Make an overlay per environment that sets the image and the Secret.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
labels:
  - pairs:
      app.kubernetes.io/name: {{k8s_name}}
    includeSelectors: true
components:
{{kustomize_components}}
images:
  # Set the registry and the release tag in your overlay.
  - name: {{k8s_name}}
    newTag: 0.1.0
