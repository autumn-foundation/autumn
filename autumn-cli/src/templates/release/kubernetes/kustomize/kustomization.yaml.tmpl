# Kustomize base for {{project_name}}.
# Generated by `autumn release init --target kubernetes`.
# Make an overlay per environment that sets the image and the Secret.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
labels:
  - pairs:
      app.kubernetes.io/name: {{k8s_name}}
    includeSelectors: true
resources:
  - deployment.yaml
  - service.yaml
  - pdb.yaml
images:
  - name: {{k8s_name}}
    newTag: latest
