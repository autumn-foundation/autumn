# Values for the {{project_name}} chart.
# Generated by `autumn release init --target kubernetes`.

replicaCount: 2

# Override the chart name, or the whole object name. Names are cut to 55
# characters, so Flagger can add -primary or -canary.
nameOverride: ""
fullnameOverride: ""

# Extra pod annotations.
podAnnotations: {}

image:
  repository: {{k8s_name}}
  # Empty: use the chart appVersion.
  tag: ""
  pullPolicy: IfNotPresent

imagePullSecrets: []

# Required. The public host names of the app, for [security.trusted_hosts].
# The prod profile does not start without them. The chart also trusts the
# pod IP, so Prometheus can scrape the pod by its IP.
trustedHosts: []
#  - shop.example.com

# Extra environment variables for the app container.
env: []
# Put secrets in a Secret and load them here, for example:
#   - secretRef:
#       name: {{k8s_name}}-secrets
# The Secret holds AUTUMN_DATABASE__PRIMARY_URL and
# AUTUMN_SECURITY__SIGNING_SECRET. The prod profile does not start without
# a signing secret.
envFrom: []

containerPort: 3000

service:
  type: ClusterIP
  port: 80

# Probe paths. They match the [health] defaults. Do not point a probe at
# the health alias: it fails when a dependency is down.
probes:
  livePath: /live
  readyPath: /ready
  startupPath: /startup

# Shutdown timing. The chart sets AUTUMN_SERVER__PRESTOP_GRACE_SECS and
# AUTUMN_SERVER__SHUTDOWN_TIMEOUT_SECS from these values, and sets
#   terminationGracePeriodSeconds = preStopSleepSeconds + prestopGraceSeconds
#                                   + shutdownTimeoutSeconds + bufferSeconds
# so Kubernetes never kills the pod during the drain window.
shutdown:
  # The preStop hook sleeps this long before SIGTERM, so endpoints update.
  preStopSleepSeconds: 5
  # After SIGTERM, /ready returns 503 for this long before the listener closes.
  prestopGraceSeconds: 5
  # In-flight requests and shutdown hooks finish in this time.
  shutdownTimeoutSeconds: 30
  # Extra time. It must be 1 or more.
  bufferSeconds: 10

podDisruptionBudget:
  enabled: true
  maxUnavailable: 1

resources: {}
nodeSelector: {}
tolerations: []
affinity: {}

metrics:
  # The scrape path: your [actuator] prefix, then /prometheus.
  path: /actuator/prometheus
  # Add prometheus.io/* scrape annotations to each pod. The chart does not
  # add them when podMonitor is on, so Prometheus does not scrape a pod twice.
  annotations: true
  # A prometheus-operator PodMonitor. Needs the monitoring.coreos.com CRDs.
  # It selects pods, so it also finds the Flagger primary and canary pods.
  podMonitor:
    enabled: false
    interval: 30s
    # Labels that your Prometheus selects on, for example
    # `release: kube-prometheus-stack`.
    labels: {}

# Argo Rollouts canary. Needs the Argo Rollouts controller. The chart then
# renders a Rollout, not a Deployment.
rollout:
  enabled: false
  steps:
    - setWeight: 20
    - pause: {duration: 2m}
    - setWeight: 50
    - pause: {duration: 5m}

# Flagger canary. Needs Flagger. Flagger makes the Services, so the chart does
# not render one. Do not set this and rollout.enabled together.
flagger:
  enabled: false
  # The traffic provider, for example nginx, istio or gatewayapi:v1. Empty:
  # Flagger's default. With the plain kubernetes provider, Flagger does a
  # blue/green test, not a weighted canary.
  provider: ""
  # The Ingress for an ingress provider (nginx, contour, ...), for example
  # {apiVersion: networking.k8s.io/v1, kind: Ingress, name: shop}.
  ingressRef: {}
  # Extra Canary spec.service fields for a mesh or Gateway API provider, for
  # example gatewayRefs (gatewayapi) or hosts and gateways (istio).
  service: {}
  # Flagger webhooks, for example a load test. A canary with no traffic gives
  # no metric values, and Flagger fails it.
  webhooks: []
  interval: 1m
  threshold: 2
  maxWeight: 50
  stepWeight: 10

# Rollout analysis. `autumn slo generate` writes deploy/slo/helm-values.yaml
# with these values. Use it with -f.
analysis:
  # The Argo Rollouts AnalysisTemplate. Empty: no analysis.
  templateName: ""
  # A canary fails above this burn rate (error ratio / error budget).
  maxBurnRate: 14.4
  # The Flagger MetricTemplates.
  metricTemplates: []
