{{- if .Values.flagger.enabled }}
apiVersion: flagger.app/v1beta1
kind: Canary
metadata:
  name: {{ include "app.fullname" . }}
  labels:
    {{- include "app.labels" . | nindent 4 }}
spec:
  {{- with .Values.flagger.provider }}
  provider: {{ . }}
  {{- end }}
  {{- with .Values.flagger.ingressRef }}
  ingressRef:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ include "app.fullname" . }}
  service:
    port: {{ .Values.service.port }}
    targetPort: http
  analysis:
    interval: {{ .Values.flagger.interval }}
    threshold: {{ .Values.flagger.threshold }}
    maxWeight: {{ .Values.flagger.maxWeight }}
    stepWeight: {{ .Values.flagger.stepWeight }}
    metrics:
      {{- range .Values.analysis.metricTemplates }}
      # The SLO burn rate of the canary pods.
      - name: {{ . }}
        templateRef:
          name: {{ . }}
          namespace: {{ $.Release.Namespace }}
        thresholdRange:
          max: {{ $.Values.analysis.maxBurnRate }}
        interval: {{ $.Values.flagger.interval }}
      {{- end }}
    {{- with .Values.flagger.webhooks }}
    webhooks:
      {{- toYaml . | nindent 6 }}
    {{- end }}
{{- end }}
