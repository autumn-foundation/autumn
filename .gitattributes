# Normalise line endings for all text files on checkout.
* text=auto

# Shell gates must stay LF-normalized on Windows; CRLF makes bash see
# carriage returns in options and blank lines.
*.sh text eol=lf

# Force LF for embedded Markdown content used via include_str! so that
# git autocrlf on Windows does not corrupt the frontmatter delimiters.
examples/wiki/content/*.md text eol=lf
autumn/src/**/*.md text eol=lf

# Every built-in starter is embedded via include_dir! and compared byte-for-byte
# against its rendered form under examples/; force LF on both sides so Windows
# autocrlf does not introduce line-ending drift (mirrors the eol=lf rules
# above). The starters/ rule is deliberately whole-tree rather than per-starter:
# that directory holds nothing but starter templates, and the drift gate is the
# same for every one of them, so a new starter inherits the rule instead of
# failing `Test (windows-latest)` on its first CI run — which is exactly what
# `cms` did. The examples/ side stays per-directory, since examples/ holds
# plenty of trees that are not starters.
autumn-cli/src/starters/** text eol=lf
examples/saas/** text eol=lf
examples/cms/** text eol=lf

# Golden snapshots are compared byte-for-byte against generator output
# (which always emits LF); force LF so Windows autocrlf does not fail the
# comparison on checkout (same rationale as the saas rules above).
autumn-cli/tests/golden/** text eol=lf

# Fuzz corpus seeds are byte-exact regression inputs (MIME bodies where CRLF is
# semantically meaningful); never normalize or diff them as text.
fuzz/corpus/** binary

# Same reason: the react-graphql example diff-tests this committed SDL against
# the schema it serves via include_str!; CRLF on checkout would fail the gate.
examples/react-graphql/schema.graphql text eol=lf
