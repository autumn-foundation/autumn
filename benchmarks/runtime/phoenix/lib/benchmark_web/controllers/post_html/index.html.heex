<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Posts</title>
  </head>
  <body>
    <h1>Posts</h1>
    <ul>
      <li :for={post <- @posts}>
        <a href={"/posts/#{post.id}"}>{post.title}</a>
        &mdash; {post.author}
        <em :if={!post.published}>[draft]</em>
      </li>
    </ul>
  </body>
</html>
